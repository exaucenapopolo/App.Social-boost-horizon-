{
  "expo": {
    "name": "Social Boost Horizon",
    "slug": "social-boost-horizon",
    "version": "1.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "socialboost",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "runtimeVersion": "sbh-v1",

    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.socialboost237.socialboosthorizon"
    },

    "web": {
      "favicon": "./assets/images/icon.png",
      "shortName": "Social Boost Horizon",
      "orientation": "portrait",
      "backgroundColor": "#FFFFFF",
      "name": "Social Boost Horizon"
    },

    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/4c729449-8668-490a-a10c-a31e8e00b50b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

   "experiments": {
  "typedRoutes": true,
  "reactCompiler": false,
  "autolinkingModuleResolution": true
   }

    "extra": {
      "router": {
        "origin": "https://socialboosthorizon.com"
      },
      "eas": {
        "projectId": "4c729449-8668-490a-a10c-a31e8e00b50b"
      }
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates"
    ],

    "owner": "socialboost237"
  }
}